{
  "name": "altium-to-circuit-json",
  "version": "0.0.98",
  "description": "Convert Altium schematic and PCB documents into Circuit JSON",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "trustedDependencies": [
    "altiumts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/altium-to-circuit-json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup-node lib/index.ts --format esm --dts --sourcemap --clean",
    "convert:ti-reference": "bun run download-references && bun run scripts/convert-ti-reference.ts",
    "download-references": "bun run scripts/download-references.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "prepack": "bun run build",
    "prepare": "bun run scripts/prepare-git-dependency.ts",
    "test": "bun run download-references && bun test",
    "test:update-svg": "bun run download-references && BUN_UPDATE_SNAPSHOTS=1 bun test tests/svg",
    "typecheck": "bunx tsc --noEmit",
    "build:site": "vite build --config vite.config.ts",
    "dev": "vite --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "start": "bun run dev",
    "vercel-build": "bun run build:site"
  },
  "dependencies": {
    "@tscircuit/math-utils": "^0.0.9",
    "altiumts": "github:tscircuit/altiumts#8db22cf449c7bf6584a968b4913be4e1bd4a93ad",
    "circuit-json": "0.0.486",
    "format-si-unit": "^0.0.11",
    "polygon-clipping": "^0.15.7",
    "schematic-symbols": "^0.0.238",
    "transformation-matrix": "^2.16.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@tscircuit/alphabet": "^0.0.25",
    "@tscircuit/circuit-json-util": "^0.0.102",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "fflate": "^0.8.3",
    "bun-match-svg": "^0.0.15",
    "circuit-json-to-connectivity-map": "^0.0.25",
    "circuit-to-svg": "^0.0.436",
    "circuit-to-svg-schematic-graphics": "npm:circuit-to-svg@0.0.436",
    "sharp": "^0.35.3",
    "stack-svgs": "^0.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.5",
    "vite": "^8.0.8",
    "vercel": "^50.42.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
